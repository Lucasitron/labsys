# FabLab — variáveis operacionais do Compose (SEM valores reais).
# Copiar para `infra/.env` (chmod 600) e preencher, ou exportar no shell.
# NUNCA commitar `infra/.env` nem valores reais aqui.

# --- Postgres (banco único `fablab`) ---
POSTGRES_USER=fablab
POSTGRES_PASSWORD=
POSTGRES_DB=fablab

# --- Laravel (obrigatórios em todo overlay) ---
# Gerar com: php artisan key:generate --show
APP_KEY=
# Gerar com: php artisan jwt:secret --show
JWT_SECRET=
APP_URL=http://localhost:8080
APP_DEBUG=true
LOG_LEVEL=debug

# --- Seed do admin raiz (dev-only: NUNCA true em produção real) ---
AUTH_SEED_ENABLED=true
AUTH_SEED_EMAIL=admin@fablab.org
AUTH_SEED_USERNAME=admin
AUTH_SEED_PASSWORD=admin123

# --- Imagem publicada (testing/prod) ---
# testing default: `testing`. Prod: OBRIGATÓRIA (ex.: TAG=1.2.3).
TAG=
