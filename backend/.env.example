APP_NAME=FabLab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fablab
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# JWT (HMAC SHA-256, issuer fablab): access 15min / refresh 7 dias / skew 5s.
# Gerar com: php artisan jwt:secret (nunca versionar o valor real).
JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=10080
JWT_ALGO=HS256
JWT_LEEWAY=5
JWT_BLACKLIST_ENABLED=false

# Seed do login admin raiz (dev-only: nunca habilitar em produção).
AUTH_SEED_ENABLED=false
AUTH_SEED_EMAIL=admin@fablab.org
AUTH_SEED_USERNAME=admin
AUTH_SEED_PASSWORD=admin123
AUTH_SEED_ID_USER=1
AUTH_SEED_UUID=admin-root-rfid
AUTH_SEED_SETOR=ADMINISTRACAO

# E-mail das notificações (MVP: Mail::raw fail-soft; sem SMTP a row fica
# PENDENTE p/ retry — nunca versionar credencial real).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="fablab@localhost"
MAIL_FROM_NAME="FabLab"

# Schedulers do Notification (kill-switches, default on).
NOTIFICATION_REENVIO_SCHEDULER_ENABLED=true
NOTIFICATION_EXPURGO_SCHEDULER_ENABLED=true
